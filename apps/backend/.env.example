APP_NAME="Riyadh Tow Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The Next.js app's own origin — the only origin config/cors.php allows
# (see docs/SECURITY.md §CORS). Set to the real production frontend
# domain once one exists.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tow_platform
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Comma-separated origins allowed to authenticate via Sanctum's SPA cookie
# flow (the Next.js web app). Do not use a wildcard.
SANCTUM_STATEFUL_DOMAINS=localhost:3000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Google Maps Platform — see docs/ARCHITECTURE.md §6 (Maps abstraction).
# Never commit a real key; local dev can run against the fake provider
# when this is left blank (wired up in Phase 6).
GOOGLE_MAPS_API_KEY=

# Payment gateway — see docs/PAYMENT_ARCHITECTURE.md. Left blank until a
# real gateway account exists; the fake gateway adapter is used instead.
PAYMENT_GATEWAY_DRIVER=fake
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# SMS provider — see docs/NOTIFICATIONS.md. Left blank until a real
# provider account exists; the log/fake adapter is used instead.
SMS_PROVIDER_DRIVER=log
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Push/email/WhatsApp providers — see docs/NOTIFICATIONS.md. Same "log
# adapter until a real vendor exists" pattern as SMS above.
PUSH_PROVIDER_DRIVER=log
PUSH_PROVIDER_API_KEY=
EMAIL_PROVIDER_DRIVER=log
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_FROM_ADDRESS=
WHATSAPP_PROVIDER_DRIVER=log
WHATSAPP_PROVIDER_API_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
