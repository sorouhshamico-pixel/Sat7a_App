# The Laravel API this app proxies every request through server-side route
# handlers (see src/app/api/backend/[...path]/route.ts and
# docs/OPERATIONS_COMMAND_CENTER.md) — never called directly from the
# browser, so the Sanctum session token never reaches client-side JS.
BACKEND_API_URL=http://localhost:8000

# This app's own public origin — used to build absolute URLs in metadata
# (Open Graph images, sitemap.xml, robots.txt's sitemap pointer). Set to
# the real production domain once one exists; see docs/MARKETING_SEO.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
